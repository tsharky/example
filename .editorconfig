# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespaces = true
insert_final_newline = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespaces = false
